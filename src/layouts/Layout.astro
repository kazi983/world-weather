---
import '../sass/global.scss';
import FavoriteCities from '../components/FavoriteCities.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import TemperatureToggle from '../components/TemperatureToggle.astro';

const title = 'SMK World Weather';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <LoadingScreen />
    <div id="globe"></div>

    <div class="content">
      <div id="errorBanner" class="hidden errorBanner" role="alert">
        <span id="errorBannerMessage"></span>
      </div>

      <header>
        <div class="navRow">
          <h1 class="font-title siteTitle">
            <a href="/">{title}</a>
          </h1>

          <div class="searchContainer">
            <svg
              class="searchIcon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>

            <input
              id="search"
              type="text"
              placeholder="Search a city..."
              autocomplete="off"
            />

            <!-- autocomplete = Don't show the browser's saved suggestions for this input. -->
            <ul id="dropdown" class="hidden"></ul>
          </div>

          <div class="navControls">
            <TemperatureToggle />

            <div class="favoritesWrapper">
              <FavoriteCities />
            </div>
          </div>
        </div>
      </header>

      <slot />
    </div>

    <style lang="scss">
      .errorBanner {
        width: min(900px, calc(100% - 2rem));
        margin: 0 auto 1rem;
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        background: rgba(248, 113, 113, 0.15);
        border: 1px solid rgba(248, 113, 113, 0.4);
        color: #fecaca;
        text-align: center;
        font-weight: 600;
      }

      .errorBanner.hidden {
        display: none;
      }

      .navRow {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .siteTitle {
        font-weight: 700;
        white-space: nowrap;
      }

      .searchContainer {
        flex: 1 1 240px;
        max-width: 380px;
      }

      .navControls {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      @media (max-width: 640px) {
        .navRow {
          justify-content: center;
          text-align: center;
        }

        .searchContainer {
          order: 3;
          flex-basis: 100%;
          max-width: none;
        }

        .navControls {
          order: 2;
        }
      }
    </style>

    <script>
      import { $selectedPlace, type City } from '../stores/placeStore';
      import { $appError } from '../stores/errorStore';
      import { moveGlobe } from '../scripts/globe';
      import { debounce } from '../lib/common';

      // ==========================================================================
      // DOM
      // ==========================================================================

      const searchInput = document.querySelector<HTMLInputElement>('#search');
      const dropdown = document.querySelector<HTMLUListElement>('#dropdown');
      const errorBanner = document.querySelector<HTMLElement>('#errorBanner');
      const errorBannerMessage = document.querySelector<HTMLElement>(
        '#errorBannerMessage',
      );

      // ==========================================================================
      // API
      // ==========================================================================

      const PLACES_URL = 'https://api.placekit.co/search';
      const PLACEKIT_API_KEY = import.meta.env.PUBLIC_PLACEKIT_API_KEY;

      let searchResults: City[] = [];

      async function searchPlaces(query: string) {
        const response = await fetch(PLACES_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-placekit-api-key': PLACEKIT_API_KEY,
          },
          body: JSON.stringify({
            query: query,
            types: ['city'],
            maxResults: 5,
            language: 'en',
          }),
        });

        if (!response.ok) {
          throw new Error('Placeskit error' + response.status);
        }

        const data = await response.json();
        searchResults = data.results;
        return searchResults;
      }

      // ==========================================================================
      // Functions
      // ==========================================================================

      function renderDropdown(items: City[]): void {
        if (!dropdown) return;

        dropdown.innerHTML = '';

        if (items.length === 0) {
          const emptyItem = document.createElement('li');
          emptyItem.textContent = 'No Result';
          dropdown.append(emptyItem);
        }

        items.forEach((item, index) => {
          if (item.city && item.administrative && item.country) {
            const li = document.createElement('li');
            li.dataset.index = String(index);
            li.textContent = `${item.city}, ${item.administrative}, ${item.country}`;
            dropdown.append(li);
          }
        });

        dropdown.classList.remove('hidden');
      }

      async function fetchCities(query: string) {
        if (query.length < 2) {
          dropdown?.classList.add('hidden');
          return;
        }

        try {
          const places = await searchPlaces(query);

          renderDropdown(places);
          $appError.set(null);
        } catch (error) {
          console.error('Failed to search places:', error);
          $appError.set(
            'Could not search cities. Please check your connection.',
          );
        }
      }

      const debouncedFetchCities = debounce(fetchCities, 500);

      // ==========================================================================
      // Event listeners
      // ==========================================================================
      searchInput?.addEventListener('input', () => {
        const query = searchInput.value.trim();

        debouncedFetchCities(query);
      });

      // Hide dropdown when clicking outside the search area
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        if (
          !event.target.closest('#search') &&
          !event.target.closest('#dropdown')
        ) {
          dropdown?.classList.add('hidden');
        }
      });

      dropdown?.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const item = target.closest<HTMLLIElement>('li[data-index]');
        if (!item) return;

        const index = Number(item.dataset.index);
        const place = searchResults[index];
        $selectedPlace.set(place);

        if (searchInput) {
          searchInput.value = '';
        }

        dropdown.classList.add('hidden');
        moveGlobe(place);
      });

      // ==========================================================================
      // Store subscriptions
      // ==========================================================================

      $appError.subscribe((message) => {
        if (!errorBanner || !errorBannerMessage) return;

        if (message) {
          errorBannerMessage.textContent = message;
          errorBanner.classList.remove('hidden');
        } else {
          errorBanner.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>
