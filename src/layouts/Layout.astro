---
import "../sass/global.scss";

const title = "KMS Weather";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"
    ></script>
    <script
      is:inline
      src="https://code.jquery.com/jquery-4.0.0.js"
      integrity="sha256-9fsHeVnKBvqh3FB2HYu7g2xseAZ5MlN6Kz/qnkASV8U="
      crossorigin="anonymous"></script>
  </head>
  <body>
    <!-- Miu -->
    <header class="p-3">
      <h1 class="text-3xl font-bold text-center mb-6">{title}</h1>

      <div class="absolute top-4 right-10">
        💜<select
          id="favoriteCities"
          class="border border-gray-300 rounded-lg p-2 bg-white left-10"
        >
          <option>Vancouver</option>
          <option>Toronto</option>
          <option>Montreal</option>
        </select>
      </div>

      <div class="relative">
        <input
          id="search"
          type="text"
          placeholder="Type a city or address"
          autocomplete="off"
          class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-400"
        />

        <!-- autocomplete = Don't show the browser's saved suggestions for this input. -->
        <ul
          id="dropdown"
          class="absolute left-0 right-0 bg-white border border-gray-300 rounded-lg mt-1 shadow-md overflow-hidden z-10 pl-2"
        >
        </ul>
      </div>
    </header>

    <slot />
    <script is:inline>
      // API
      const PLACES_URL = "https://api.placekit.co/search";
      const PLACEKIT_API_KEY =
        "pk_NpHw+lysJvBzigbRf/VpUDyRj7pjydvA0MBR93LmoPI=";

      // Search Place============================================
      let searchResults = [];
      let selectedPlace;

      async function searchPlaces(query) {
        const response = await fetch(PLACES_URL, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "x-placekit-api-key": PLACEKIT_API_KEY,
          },
          body: JSON.stringify({
            query: query,
            types: ["country", "city"],
            // types: ["country", "city", "administrative"],
            maxResults: 5,
          }),
        });

        if (!response.ok) {
          throw new Error("Placeskit error" + response.status);
        }

        const data = await response.json();
        searchResults = data.results; //"Take the PlaceKit results and save them in my results variable."
        return searchResults;
      }

      $("#search").on("input", async function () {
        const query = $(this).val().trim(); //Get what the user typed and remove unnecessary spaces.

        if (query.length < 2) {
          $("#dropdown").addClass("hidden");
          return;
        }
        const places = await searchPlaces(query);
        renderDropdown(places);
      });

      // SHOW Place ===============================================

      function renderDropdown(items) {
        const $dropdown = $("#dropdown");
        $dropdown.empty(); //This removes everything currently inside the <ul>.

        if (items.length == 0) {
          $dropdown.append("<li>No Result</li>");
        }

        items.forEach(function (item, index) {
          
          // show only have info city, administrative or country
          if(item.city && item.administrative && item.country){
            const li = `<li data-index="${index}" class = "hover:bg-gray-100">${item.city}, ${item.administrative}, ${item.country}</li>`;
            $dropdown.append(li);
          }        
        });
        $dropdown.removeClass("hidden");
      }

      // Select Place============================================
      $("#dropdown").on("click", "li[data-index]", function () {
        const index = $(this).data("index");
        // console.log(`index: ${index}`); // 0,1,2...

        selectedPlace = searchResults[index];
        // console.log(selectedPlace);

        // console.log(selectedPlace.lat);
        // console.log(selectedPlace.lng);
      });
    </script>
  </body>
</html>
