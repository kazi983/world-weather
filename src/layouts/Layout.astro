---
import '../sass/global.scss';
import FavoriteCities from '../components/FavoriteCities.astro';

const title = 'KMS Weather';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script
      is:inline
      src="https://code.jquery.com/jquery-4.0.0.js"
      integrity="sha256-9fsHeVnKBvqh3FB2HYu7g2xseAZ5MlN6Kz/qnkASV8U="
      crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="p-3">
      <h1 class="mb-6 font-bold text-3xl text-center">{title}</h1>

      <div class="top-4 right-10 absolute">
        <FavoriteCities />
      </div>

      <div class="relative">
        <input
          id="search"
          type="text"
          placeholder="Type a city or address"
          autocomplete="off"
          class="p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 w-full"
        />

        <!-- autocomplete = Don't show the browser's saved suggestions for this input. -->
        <ul
          id="dropdown"
          class="right-0 left-0 z-10 absolute bg-white shadow-md mt-1 pl-2 border border-gray-300 rounded-lg overflow-hidden"
        >
        </ul>
      </div>
    </header>

    <slot />
    <script>
      /// <reference types="jquery" />
      import { selectedPlace } from "../stores/weatherStore";
      // API
      const PLACES_URL = 'https://api.placekit.co/search';
      const PLACEKIT_API_KEY = 'pk_NpHw+lysJvBzigbRf/VpUDyRj7pjydvA0MBR93LmoPI=';

      // Search Place============================================
      let searchResults: any[] = [];

      async function searchPlaces(query: string) {
        const response = await fetch(PLACES_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-placekit-api-key': PLACEKIT_API_KEY,
          },
          body: JSON.stringify({
            query: query,
            types: ['city'],
            maxResults: 5,
            language: 'en'
          }),
        });

        if (!response.ok) {
          throw new Error('Placeskit error' + response.status);
        }

        const data = await response.json();
        searchResults = data.results; //"Take the PlaceKit results and save them in my results variable."
        return searchResults;
      }

      $('#search').on('input', async function () {
        const query = ($(this).val() as string).trim(); //Get what the user typed and remove unnecessary spaces.

        if (query.length < 2) {
          $('#dropdown').addClass('hidden');
          return;
        }
        const places = await searchPlaces(query);
        renderDropdown(places);
      });

      // SHOW Place ===============================================

      function renderDropdown(items: any[]) {
        const $dropdown = $('#dropdown');
        $dropdown.empty(); //This removes everything currently inside the <ul>.

        if (items.length == 0) {
          $dropdown.append('<li>No Result</li>');
        }

        items.forEach(function (item, index) {
          // show only have info city, administrative or country
          if (item.city && item.administrative && item.country) {
            const li = `<li data-index="${index}" class = "hover:bg-gray-100">${item.city}, ${item.administrative}, ${item.country}</li>`;
            $dropdown.append(li);
          }
        });
        $dropdown.removeClass('hidden');
      }

      // ux  hide dropdown if click other place when dropdown is open
      $(document).on("click", function (event) {
      if (
        !$(event.target).closest("#search").length &&
        !$(event.target).closest("#dropdown").length
      ) {
        $("#dropdown").addClass("hidden");
      }
    });

      // Select Place============================================
      $('#dropdown').on('click', 'li[data-index]', function () {
        const index = $(this).data('index');
        const place = searchResults[index];
        selectedPlace.set(place);
        console.log(selectedPlace.get());

        $("#search").val(`${place.city}, ${place.administrative}, ${place.country}`); // show selected 
        // place on search bar.
        $("#dropdown").addClass("hidden"); // close dropdown when selected 

        // console.log(selectedPlace.lat);
        // console.log(selectedPlace.lng);
      });
    </script>
  </body>
</html>
