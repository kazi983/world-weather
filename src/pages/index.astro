---
import Layout from '../layouts/Layout.astro';
import CurrentWeather from '../components/CurrentWeather.astro';
import DailyForecast from '../components/DailyForecast.astro';
import HourlyForecast from '../components/HourlyForecast.astro';
import TemperatureToggle from '../components/TemperatureToggle.astro';
---

<Layout>
  <main>
    <!-- Sarai: Temperature Unit Toggle -->
    <TemperatureToggle />

    <!-- Sarai: Weather UI -->
    <CurrentWeather />
    <DailyForecast />
    <HourlyForecast />
  </main>
</Layout>

<script>
  import { type City, $selectedPlace } from '../stores/placeStore';
  import { $weatherData, $selectedDayIndex } from '../stores/weatherStore';
  import { $appError } from '../stores/errorStore';
  import { getWeather } from '../scripts/weatherApi';
  import { getGeolocation } from '../scripts/geolocationApi';

  type Coords = {
    latitude: number;
    longitude: number;
  };

  // Default location: Vancouver
  const currentCoords: Coords = {
    latitude: 49.246292,
    longitude: -123.116226,
  };

  async function loadWeather(
    latitude: number,
    longitude: number,
    city?: string,
    countryCode?: string,
  ) {
    try {
      const weather = await getWeather(latitude, longitude);

      $weatherData.set({
        weather,
        city: city ?? 'Current Location',
        countryCode: countryCode ?? '',
      });

      $selectedDayIndex.set(0);
      $appError.set(null);
    } catch (error) {
      console.error('Failed to load weather:', error);
      $appError.set('Please check your connection and reload.');
    }
  }

  function getLocation() {
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(success, fallback, {
        timeout: 3000,
      });
    }
  }

  async function success(position: GeolocationPosition) {
    currentCoords.latitude = position.coords.latitude;
    currentCoords.longitude = position.coords.longitude;

    let city: City | undefined;

    try {
      const geolocation = await getGeolocation(
        currentCoords.latitude,
        currentCoords.longitude,
      );

      if (geolocation) {
        city = {
          city: geolocation.city,
          administrative: geolocation.principalSubdivision,
          country: geolocation.countryName,
          countrycode: geolocation.countryCode,
          lat: geolocation.latitude,
          lng: geolocation.longitude,
        };

        $selectedPlace.set(city);
      }
    } catch (error) {
      console.error('Failed to reverse geocode location:', error);
    }

    loadWeather(
      currentCoords.latitude,
      currentCoords.longitude,
      city?.city ?? 'Current Location',
      city?.countrycode ?? '',
    );
  }

  // Load Vancouver as the default weather
  function fallback() {
    $selectedPlace.set({
      city: 'Vancouver',
      administrative: 'British Columbia',
      country: 'Canada',
      countrycode: 'CA',
      lat: currentCoords.latitude,
      lng: currentCoords.longitude,
    });

    loadWeather(
      currentCoords.latitude,
      currentCoords.longitude,
      'Vancouver',
      'CA',
    );
  }

  $selectedPlace.subscribe((place) => {
    if (!place) {
      return;
    }

    loadWeather(place.lat, place.lng, place.city, place.countrycode);
  });

  // Try to use the user's current location
  getLocation();
</script>
