<section id="dailyForecast" class="dailyForecast">
  <div class="dailyForecastHeading">
    <div>
      <p class="dailyForecastLabel">Forecast</p>
      <h2>5-Day Forecast</h2>
    </div>
  </div>

  <div id="dailyForecastList" class="dailyForecastList">
    <button class="forecastCard active" type="button" data-day-index="0">
      <span class="forecastCardDay text-transition">Today</span>
      <img class="forecastCardIcon" alt="" />
      <span class="forecastCardTemperature text-transition">--°</span>
      <span class="forecastCardCondition text-transition">--</span>
    </button>

    <button class="forecastCard" type="button" data-day-index="1">
      <span class="forecastCardDay text-transition">Day 2</span>
      <img class="forecastCardIcon" alt="" />
      <span class="forecastCardTemperature text-transition">--°</span>
      <span class="forecastCardCondition text-transition">--</span>
    </button>

    <button class="forecastCard" type="button" data-day-index="2">
      <span class="forecastCardDay text-transition">Day 3</span>
      <img class="forecastCardIcon" alt="" />
      <span class="forecastCardTemperature text-transition">--°</span>
      <span class="forecastCardCondition text-transition">--</span>
    </button>

    <button class="forecastCard" type="button" data-day-index="3">
      <span class="forecastCardDay text-transition">Day 4</span>
      <img class="forecastCardIcon" alt="" />
      <span class="forecastCardTemperature text-transition">--°</span>
      <span class="forecastCardCondition text-transition">--</span>
    </button>

    <button class="forecastCard" type="button" data-day-index="4">
      <span class="forecastCardDay text-transition">Day 5</span>
      <img class="forecastCardIcon" alt="" />
      <span class="forecastCardTemperature text-transition">--°</span>
      <span class="forecastCardCondition text-transition">--</span>
    </button>
  </div>
</section>

<style lang="scss">
  @use '../sass/variables' as *;

  .dailyForecastHeading {
    margin-bottom: 1.5rem;
  }

  .dailyForecastHeading h2 {
    margin: 0;
  }

  .dailyForecastLabel {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }

  .dailyForecastList {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
    padding-top: 3px;
  }

  .forecastCard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding: 1.25rem 0.75rem;
    border: 1px solid $chip-border;
    border-radius: 1rem;
    background: $chip-bg;
    color: $text-primary;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .forecastCard:hover {
    transform: translateY(-3px);
    background: $chip-bg-hover;
  }

  .forecastCard.active {
    border: 2px solid $accent;
    background: $chip-bg-hover;
  }

  .forecastCardDay {
    font-weight: 700;
  }

  .forecastCardIcon {
    width: 3rem;
    height: 3rem;

    @media (min-width: 960px) {
      width: 6rem;
      height: 6rem;
    }
  }

  .forecastCardTemperature {
    font-size: 1.15rem;
    font-weight: 700;
    display: flex;
    flex-direction: column;

    @media (min-width: 960px) {
      flex-direction: row;
      gap: 1rem;
    }
  }

  .forecastCardCondition {
    font-size: 0.8rem;
    text-align: center;
    opacity: 0.7;
  }

  @media (max-width: 700px) {
    .dailyForecastList {
      display: flex;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }

    .forecastCard {
      padding-inline: 0.25rem;
    }
  }
</style>

<script>
  import {
    $weatherData,
    $temperatureUnit,
    $selectedDayIndex,
    type TemperatureUnit,
    type WeatherApiResponse,
  } from '../stores/weatherStore';
  import {
    celsiusToFahrenheit,
    getWeatherDescription,
    getWeatherIconUrl,
  } from '../scripts/weatherDisplay';
  import { setTextWithTransition, withTransition } from '../lib/common';

  let dailyWeatherData: WeatherApiResponse['daily'] | null = null;
  let currentUnit: TemperatureUnit = 'celsius';

  const forecastCards =
    document.querySelectorAll<HTMLButtonElement>('.forecastCard');

  function displayDailyForecast() {
    const daily = dailyWeatherData;

    if (!daily) {
      return;
    }

    forecastCards.forEach((card, index) => {
      const dayElement = card.querySelector<HTMLElement>('.forecastCardDay');

      const iconElement =
        card.querySelector<HTMLImageElement>('.forecastCardIcon');

      const temperatureElement = card.querySelector<HTMLElement>(
        '.forecastCardTemperature',
      );

      const conditionElement = card.querySelector<HTMLElement>(
        '.forecastCardCondition',
      );

      const date = new Date(`${daily.time[index]}T12:00:00`);

      const dayName =
        index === 0
          ? 'Today'
          : date.toLocaleDateString('en-CA', {
              weekday: 'short',
            });

      const weatherDescription = getWeatherDescription(
        daily.weather_code[index],
      );

      if (dayElement) {
        setTextWithTransition(dayElement, dayName);
      }

      if (iconElement) {
        iconElement.src = getWeatherIconUrl(weatherDescription.icon);
      }

      if (temperatureElement) {
        let max = daily.temperature_2m_max[index];
        let min = daily.temperature_2m_min[index];

        if (currentUnit === 'fahrenheit') {
          max = celsiusToFahrenheit(max);
          min = celsiusToFahrenheit(min);
        }

        const unit = currentUnit === 'fahrenheit' ? '°F' : '°C';

        withTransition(temperatureElement, () => {
          const maxTempElement = document.createElement('span');
          const minTempElement = document.createElement('span');

          maxTempElement.textContent = `${Math.round(max)}${unit}`;
          minTempElement.textContent = `${Math.round(min)}${unit}`;

          temperatureElement.textContent = '';

          temperatureElement.append(maxTempElement);
          temperatureElement.append(minTempElement);
        });
      }

      if (conditionElement) {
        setTextWithTransition(conditionElement, weatherDescription.condition);
      }
    });
  }

  function updateActiveCard(dayIndex: number): void {
    forecastCards.forEach((card) => {
      card.classList.toggle(
        'active',
        Number(card.dataset.dayIndex) === dayIndex,
      );
    });
  }

  $weatherData.subscribe((info) => {
    if (!info) {
      return;
    }

    dailyWeatherData = info.weather.daily;

    displayDailyForecast();
  });

  $temperatureUnit.subscribe((unit) => {
    currentUnit = unit;

    displayDailyForecast();
  });

  $selectedDayIndex.subscribe((dayIndex) => {
    updateActiveCard(dayIndex);
  });

  forecastCards.forEach((card) => {
    card.addEventListener('click', () => {
      const dayIndex = Number(card.dataset.dayIndex);

      $selectedDayIndex.set(dayIndex);
    });
  });
</script>
