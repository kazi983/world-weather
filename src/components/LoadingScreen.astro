<div id="loadingScreen" class="loadingScreen">
  <div id="loadingContent" class="loadingContent">
    <div class="loadingGlobe">🌍</div>

    <h1>SMK WORLD WEATHER</h1>

    <p id="loadingText">Loading...</p>

    <div class="loadingBar">
      <div class="loadingProgress"></div>
    </div>
  </div>
</div>

<style>
  .loadingScreen {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #050816;
    color: white;

    transition:
      opacity 0.6s ease,
      visibility 0.6s ease;
  }

  .loadingContent {
    text-align: center;
    transition:
      opacity 0.05s ease,
      visibility 0.05s ease;
  }

  .loadingScreen.hidden,
  .loadingContent.hidden {
    opacity: 0;
    visibility: hidden;
  }

  .loadingGlobe {
    font-size: 80px;
    animation: rotate 3s linear infinite;
  }

  h1 {
    margin-top: 20px;
    font-size: 24px;
    letter-spacing: 4px;
  }

  p {
    margin-top: 12px;
    opacity: 0.6;
  }

  .loadingBar {
    width: 180px;
    height: 3px;
    margin: 20px auto 0;

    background: rgb(255 255 255 / 15%);
    overflow: hidden;
  }

  .loadingProgress {
    width: 40%;
    height: 100%;
    background: white;

    animation: loading 1.5s ease-in-out infinite;
  }

  @keyframes rotate {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  @keyframes loading {
    0% {
      transform: translateX(-100%);
    }

    100% {
      transform: translateX(450%);
    }
  }
</style>

<script>
  import { $weatherData } from '../stores/weatherStore';
  import { $appError } from '../stores/errorStore';

  const loadingScreen = document.querySelector('#loadingScreen');
  const loadingContent = document.querySelector('#loadingContent');

  function hideLoadingScreen() {
    loadingContent?.classList.add('hidden');
    loadingScreen?.classList.add('hidden');
  }

  // subscribe() returns a function that you can call to unsubscribe
  const unsubscribeWeather = $weatherData.subscribe((weather) => {
    if (weather) {
      hideLoadingScreen();
      unsubscribeWeather();
      unsubscribeError();
    }
  });

  const unsubscribeError = $appError.subscribe((error) => {
    if (error) {
      hideLoadingScreen();
      unsubscribeWeather();
      unsubscribeError();
    }
  });
</script>
