<section id="hourlyForecast" class="hourlyForecast">
  <div class="hourlyForecastHeading">
    <div>
      <p class="hourlyForecastLabel">Hourly Weather</p>
      <h2>3-Hour Forecast</h2>
    </div>

    <p id="hourlySelectedDay">Today</p>
  </div>

  <div id="hourlyForecastList" class="hourlyForecastList">
    <p class="hourlyLoading">Loading hourly forecast...</p>
  </div>
</section>

<style lang="scss">
  @use '../sass/variables' as *;

  .hourlyForecast {
    width: min(900px, calc(100% - 2rem));
    margin: 2rem auto;
    padding: 2rem;
    background: $panel-bg;
    border: 1px solid $panel-border;
    border-radius: 1.25rem;
    color: $text-primary;
    backdrop-filter: blur($panel-blur);
    -webkit-backdrop-filter: blur($panel-blur);
    box-shadow: 0 10px 30px rgb(0 0 0 / 35%);
  }

  .hourlyForecastHeading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .hourlyForecastHeading h2 {
    margin: 0;
  }

  .hourlyForecastLabel {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }

  #hourlySelectedDay {
    margin: 0;
    font-weight: 600;
    opacity: 0.7;
  }

  .hourlyForecastList {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .hourCard {
    display: flex;
    min-width: 130px;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding: 1.25rem 0.75rem;
    background: $chip-bg;
    border: 1px solid $chip-border;
    border-radius: 1rem;
    color: $text-primary;
  }

  .hourCardTime {
    font-weight: 700;
  }

  .hourCardIcon {
    font-size: 2rem;
  }

  .hourCardTemperature {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .hourCardCondition {
    font-size: 0.8rem;
    text-align: center;
    opacity: 0.7;
  }

  .hourlyLoading {
    opacity: 0.65;
  }

  @media (max-width: 600px) {
    .hourlyForecast {
      padding: 1.25rem;
    }

    .hourlyForecastHeading {
      align-items: flex-start;
      flex-direction: column;
    }

    .hourCard {
      min-width: 120px;
    }
  }
</style>

<script>
  type HourlyWeather = {
    hourly: {
      time: string[];
      temperature_2m: number[];
      weather_code: number[];
    };
  };

  type WeatherEvent = CustomEvent<{
    weather: HourlyWeather;
    city: string;
  }>;

  let weatherData: HourlyWeather | null = null;
  let selectedDayIndex = 0;

  function getWeatherDescription(code: number) {
    if (code === 0) {
      return { condition: 'Clear', icon: '☀️' };
    }

    if (code === 1 || code === 2) {
      return { condition: 'Partly cloudy', icon: '🌤️' };
    }

    if (code === 3) {
      return { condition: 'Overcast', icon: '☁️' };
    }

    if (code === 45 || code === 48) {
      return { condition: 'Fog', icon: '🌫️' };
    }

    if (code >= 51 && code <= 57) {
      return { condition: 'Drizzle', icon: '🌦️' };
    }

    if (code >= 61 && code <= 67) {
      return { condition: 'Rain', icon: '🌧️' };
    }

    if (code >= 71 && code <= 77) {
      return { condition: 'Snow', icon: '❄️' };
    }

    if (code >= 80 && code <= 82) {
      return { condition: 'Showers', icon: '🌧️' };
    }

    if (code >= 85 && code <= 86) {
      return { condition: 'Snow showers', icon: '🌨️' };
    }

    if (code >= 95) {
      return { condition: 'Thunderstorm', icon: '⛈️' };
    }

    return { condition: 'Unknown', icon: '🌡️' };
  }

  function displayHourlyForecast(dayIndex: number) {
    if (!weatherData) {
      return;
    }

    const hourlyForecastList = document.querySelector<HTMLElement>(
      '#hourlyForecastList',
    );

    if (!hourlyForecastList) {
      return;
    }

    hourlyForecastList.innerHTML = '';

    const startIndex = dayIndex * 24;
    const endIndex = startIndex + 24;

    for (let index = startIndex; index < endIndex; index += 3) {
      const time = weatherData.hourly.time[index];

      if (!time) {
        continue;
      }

      const temperature = weatherData.hourly.temperature_2m[index];

      const weatherCode = weatherData.hourly.weather_code[index];

      const description = getWeatherDescription(weatherCode);

      const date = new Date(time);

      const formattedTime = date.toLocaleTimeString('en-CA', {
        hour: 'numeric',
        minute: '2-digit',
      });

      const hourCard = document.createElement('div');
      hourCard.className = 'hourCard';

      const timeElement = document.createElement('span');
      timeElement.className = 'hourCardTime';
      timeElement.textContent = formattedTime;

      const iconElement = document.createElement('span');
      iconElement.className = 'hourCardIcon';
      iconElement.textContent = description.icon;

      const temperatureElement = document.createElement('span');
      temperatureElement.className = 'hourCardTemperature';
      temperatureElement.textContent = `${Math.round(temperature)}°C`;

      const conditionElement = document.createElement('span');
      conditionElement.className = 'hourCardCondition';
      conditionElement.textContent = description.condition;

      hourCard.append(
        timeElement,
        iconElement,
        temperatureElement,
        conditionElement,
      );

      hourlyForecastList.append(hourCard);
    }
  }

  window.addEventListener('weatherDataUpdated', (event) => {
    const customEvent = event as WeatherEvent;

    weatherData = customEvent.detail.weather;
    selectedDayIndex = 0;

    const selectedDay =
      document.querySelector<HTMLElement>('#hourlySelectedDay');

    if (selectedDay) {
      selectedDay.textContent = 'Today';
    }

    displayHourlyForecast(selectedDayIndex);
  });

  window.addEventListener('forecastDaySelected', (event) => {
    const customEvent = event as CustomEvent<{
      dayIndex: number;
      dayName: string;
    }>;

    selectedDayIndex = customEvent.detail.dayIndex;

    const selectedDay =
      document.querySelector<HTMLElement>('#hourlySelectedDay');

    if (selectedDay) {
      selectedDay.textContent = customEvent.detail.dayName;
    }

    displayHourlyForecast(selectedDayIndex);
  });
</script>
