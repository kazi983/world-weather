<script>
  const selectedDay =
    document.querySelector<HTMLElement>('#hourly-selected-day');

  window.addEventListener('forecast-day-selected', (event) => {
    const customEvent = event as CustomEvent<{
      dayIndex: number;
      dayName: string;
    }>;

    if (selectedDay) {
      selectedDay.textContent = customEvent.detail.dayName;
    }
  });
</script>