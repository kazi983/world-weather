<section id="currentWeather" class="currentWeather">
  <button
    id="favoriteButton"
    class="favoriteButton"
    type="button"
    aria-pressed="false"
    aria-label="Add to favorites"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="30"
      height="30"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      data-lucide="star"
      aria-hidden="true"
      class="lucide lucide-star"
    >
      <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path>
    </svg>
  </button>

  <div class="currentWeatherHeader">
    <div>
      <p class="currentWeatherLabel">Current Weather</p>
      <h2 id="currentCity" class="text-transition">
        Vancouver
      </h2>
      <p id="currentDate" class="text-transition">
        Today
      </p>
    </div>

    <img id="currentWeatherIcon" class="currentWeatherIcon" alt="" />
  </div>

  <div class="currentWeatherMain">
    <p class="currentWeatherTemperature">
      <span id="currentTemperature" class="text-transition">
        --
      </span>
      <span id="currentTemperatureUnit" class="text-transition">
        °C
      </span>
    </p>

    <p id="currentCondition" class="currentWeatherCondition text-transition">
      Loading...
    </p>
  </div>

  <div class="currentWeatherDetails">
    <div class="weatherDetail">
      <span aria-hidden="true">💧</span>
      <div>
        <p class="weatherDetailLabel">Humidity</p>
        <p id="currentHumidity" class="text-transition">
          --%
        </p>
      </div>
    </div>

    <div class="weatherDetail">
      <span aria-hidden="true">💨</span>
      <div>
        <p class="weatherDetailLabel">Wind</p>
        <p id="currentWind" class="text-transition">
          -- km/h
        </p>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../sass/variables' as *;

  .currentWeather {
    width: min(900px, calc(100% - 2rem));
    margin: 2rem auto;
    padding: 2rem;
    background: $panel-bg;
    border: 1px solid $panel-border;
    border-radius: 1.75rem;
    color: $text-primary;
    -webkit-backdrop-filter: blur($panel-blur);
    backdrop-filter: blur($panel-blur);
    box-shadow: 0 20px 60px rgb(0 0 0 / 45%);
  }

  @media (min-width: 960px) {
    .currentWeather {
      width: min(600px, 100%);
      margin: 0;
    }
  }

  .favoriteButton {
    cursor: pointer;
    margin-bottom: 1rem;

    svg {
      fill: none;
      transition: fill 0.2s ease;
    }

    &[aria-pressed='true'] svg {
      fill: currentColor;
    }
  }

  .currentWeatherHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .currentWeatherLabel {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }

  .currentWeatherHeader h2 {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }

  .currentWeatherHeader p {
    margin-top: 0.35rem;
  }

  .currentWeatherIcon {
    display: inline-block;
    width: clamp(7rem, 14vw, 10rem);
    height: clamp(7rem, 14vw, 10rem);
    flex-shrink: 0;
  }

  .currentWeatherMain {
    margin-top: 1.5rem;
  }

  .currentWeatherTemperature {
    margin: 0;
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 700;
    line-height: 1;
  }

  .currentWeatherCondition {
    margin-top: 0.75rem;
    font-size: 1.1rem;
  }

  .currentWeatherDetails {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .weatherDetail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: $chip-bg;
    border: 1px solid $chip-border;
    border-radius: 0.9rem;
  }

  .weatherDetail > span {
    font-size: 1.5rem;
  }

  .weatherDetail p {
    margin: 0;
  }

  .weatherDetailLabel {
    margin-bottom: 0.2rem !important;
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 0.65;
  }

  @media (max-width: 600px) {
    .currentWeather {
      padding: 1.25rem;
    }

    .currentWeatherDetails {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { countryCodeEmoji } from 'country-code-emoji';
  import {
    $weatherData,
    $temperatureUnit,
    type TemperatureUnit,
    type WeatherInfo,
  } from '../stores/weatherStore';
  import {
    celsiusToFahrenheit,
    getWeatherDescription,
    getWeatherIconUrl,
  } from '../scripts/weatherDisplay';
  import { setTextWithTransition } from '../lib/common';

  let currentTemperatureCelsius: number | null = null;
  let currentUnit: TemperatureUnit = 'celsius';

  function displayTemperature() {
    if (currentTemperatureCelsius === null) {
      return;
    }

    const temperature = document.querySelector<HTMLElement>(
      '#currentTemperature',
    );

    const temperatureUnit = document.querySelector<HTMLElement>(
      '#currentTemperatureUnit',
    );

    if (!temperature || !temperatureUnit) {
      return;
    }

    if (currentUnit === 'fahrenheit') {
      setTextWithTransition(
        temperature,
        Math.round(celsiusToFahrenheit(currentTemperatureCelsius)).toString(),
      );

      setTextWithTransition(temperatureUnit, '°F');
      return;
    }

    setTextWithTransition(
      temperature,
      Math.round(currentTemperatureCelsius).toString(),
    );

    setTextWithTransition(temperatureUnit, '°C');
  }

  function updateCurrentWeather(info: WeatherInfo | null) {
    if (!info) {
      return;
    }

    const { weather, city, countryCode } = info;
    const countryFlag = countryCode ? countryCodeEmoji(countryCode) : null;

    currentTemperatureCelsius = weather.current.temperature_2m;

    const humidity = document.querySelector<HTMLElement>('#currentHumidity');

    const wind = document.querySelector<HTMLElement>('#currentWind');

    const condition = document.querySelector<HTMLElement>('#currentCondition');

    const icon = document.querySelector<HTMLImageElement>(
      '#currentWeatherIcon',
    );

    const cityElement = document.querySelector<HTMLElement>('#currentCity');

    const date = document.querySelector<HTMLElement>('#currentDate');

    const weatherDescription = getWeatherDescription(
      weather.current.weather_code,
    );

    displayTemperature();

    if (humidity) {
      setTextWithTransition(
        humidity,
        `${weather.current.relative_humidity_2m}%`,
      );
    }

    if (wind) {
      setTextWithTransition(
        wind,
        `${Math.round(weather.current.wind_speed_10m)} km/h`,
      );
    }

    if (condition) {
      setTextWithTransition(condition, weatherDescription.condition);
    }

    if (icon) {
      icon.src = getWeatherIconUrl(weatherDescription.icon);
      icon.alt = weatherDescription.condition;
    }

    if (cityElement) {
      setTextWithTransition(
        cityElement,
        countryFlag ? countryFlag + ' ' + city : city,
      );
    }

    if (date) {
      setTextWithTransition(
        date,
        new Date().toLocaleDateString('en-CA', {
          weekday: 'long',
          month: 'long',
          day: 'numeric',
        }),
      );
    }
  }

  $weatherData.subscribe(updateCurrentWeather);

  $temperatureUnit.subscribe((unit) => {
    currentUnit = unit;

    displayTemperature();
  });
</script>
