<section id="currentWeather" class="currentWeather">
  <button
    id="favoriteButton"
    class="favoriteButton"
    type="button"
    aria-pressed="false"
    aria-label="Add to favorites"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="30"
      height="30"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      data-lucide="star"
      aria-hidden="true"
      class="lucide lucide-star"
    >
      <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path>
    </svg>
  </button>

  <div class="currentWeatherHeader">
    <div>
      <p class="currentWeatherLabel">Current Weather</p>
      <h2 id="currentCity">Vancouver</h2>
      <p id="currentDate">Today</p>
    </div>

    <span
      id="currentWeatherIcon"
      class="currentWeatherIcon"
      role="img"
      aria-label="Weather condition"
    >
      ☀️
    </span>
  </div>

  <div class="currentWeatherMain">
    <p class="currentWeatherTemperature">
      <span id="currentTemperature">--</span>
      <span id="currentTemperatureUnit">°C</span>
    </p>

    <p id="currentCondition" class="currentWeatherCondition">
      Loading...
    </p>
  </div>

  <div class="currentWeatherDetails">
    <div class="weatherDetail">
      <span aria-hidden="true">💧</span>
      <div>
        <p class="weatherDetailLabel">Humidity</p>
        <p id="currentHumidity">--%</p>
      </div>
    </div>

    <div class="weatherDetail">
      <span aria-hidden="true">💨</span>
      <div>
        <p class="weatherDetailLabel">Wind</p>
        <p id="currentWind">-- km/h</p>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../sass/variables' as *;

  .currentWeather {
    width: min(900px, calc(100% - 2rem));
    margin: 2rem auto;
    padding: 2rem;
    background: $panel-bg;
    border: 1px solid $panel-border;
    border-radius: 1.25rem;
    color: $text-primary;
    -webkit-backdrop-filter: blur($panel-blur);
    backdrop-filter: blur($panel-blur);
    box-shadow: 0 10px 30px rgb(0 0 0 / 35%);
  }

  .favoriteButton {
    cursor: pointer;
    margin-bottom: 1rem;

    svg {
      fill: none;
      transition: fill 0.2s ease;
    }

    &[aria-pressed='true'] svg {
      fill: currentColor;
    }
  }

  .currentWeatherHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .currentWeatherLabel {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }

  .currentWeatherHeader h2 {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }

  .currentWeatherHeader p {
    margin-top: 0.35rem;
  }

  .currentWeatherIcon {
    display: inline-block;
    font-size: clamp(3rem, 8vw, 5rem);
  }

  .weatherClear {
    animation: weatherSpin 8s linear infinite;
  }

  .weatherCloudy,
  .weatherOvercast {
    animation: weatherBounce 2.5s ease-in-out infinite;
  }

  .weatherFog {
    animation: weatherGhost 5s ease-in-out infinite;
  }

  .weatherDrizzle {
    animation: weatherBounce 1.5s ease-in-out infinite;
  }

  .weatherRain {
    animation: weatherBounce 1.3s ease-in-out infinite;
  }

  .weatherRainShowers {
    animation: weatherBounce 1.2s ease-in-out infinite;
  }

  .weatherSnow {
    animation: weatherTumble 3s linear infinite;
  }

  .weatherSnowShowers {
    animation: weatherTumble 1.4s linear infinite;
  }

  .weatherThunderstorm {
    animation:
      weatherFlash 1.6s steps(1, end) infinite,
      weatherShake 0.4s ease-in-out infinite;
  }

  .weatherUnknown {
    animation: weatherWobble 1.4s ease-in-out infinite;
  }

  @keyframes weatherSpin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  @keyframes weatherPulse {
    0%,
    100% {
      scale: 1;
    }

    50% {
      scale: 1.25;
    }
  }

  @keyframes weatherFloat {
    0% {
      transform: translate(-12px, 0) rotate(-6deg) scale(1);
    }

    25% {
      transform: translate(0, -12px) rotate(0deg) scale(1.08);
    }

    50% {
      transform: translate(12px, 0) rotate(6deg) scale(1);
    }

    75% {
      transform: translate(0, -12px) rotate(0deg) scale(1.08);
    }

    100% {
      transform: translate(-12px, 0) rotate(-6deg) scale(1);
    }
  }

  @keyframes weatherGhost {
    0%,
    100% {
      opacity: 1;
      transform: scale(1) translateX(0);
      filter: blur(0);
    }

    50% {
      opacity: 0.2;
      transform: scale(1.3);
      filter: blur(10px);
    }
  }

  @keyframes weatherBounce {
    0%,
    100% {
      transform: translateY(0) scale(1, 1);
    }

    30% {
      transform: translateY(-20px) scale(0.95, 1.05);
    }

    50% {
      transform: translateY(0) scale(1.05, 0.95);
    }

    70% {
      transform: translateY(-8px) scale(0.95, 1.05);
    }
  }

  @keyframes weatherTumble {
    0% {
      transform: translate(0, -10px) rotate(0deg) scale(1);
    }

    25% {
      transform: translate(14px, 4px) rotate(90deg) scale(1.05);
    }

    50% {
      transform: translate(0, 12px) rotate(180deg) scale(0.95);
    }

    75% {
      transform: translate(-14px, 4px) rotate(270deg) scale(1.05);
    }

    100% {
      transform: translate(0, -10px) rotate(360deg) scale(1);
    }
  }

  @keyframes weatherFlash {
    0%,
    40%,
    60%,
    85%,
    100% {
      opacity: 1;
      scale: 1;
    }

    50%,
    92% {
      opacity: 0.25;
      scale: 1.3;
    }
  }

  @keyframes weatherShake {
    0%,
    100% {
      transform: translateX(0) rotate(0deg);
    }

    20% {
      transform: translateX(-8px) rotate(-8deg);
    }

    40% {
      transform: translateX(8px) rotate(8deg);
    }

    60% {
      transform: translateX(-6px) rotate(-5deg);
    }

    80% {
      transform: translateX(6px) rotate(5deg);
    }
  }

  @keyframes weatherWobble {
    0%,
    100% {
      transform: rotate(0deg) scale(1);
    }

    25% {
      transform: rotate(-14deg) scale(1.1);
    }

    75% {
      transform: rotate(14deg) scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .currentWeatherIcon {
      animation: none !important;
    }
  }

  .currentWeatherMain {
    margin-top: 1.5rem;
  }

  .currentWeatherTemperature {
    margin: 0;
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 700;
    line-height: 1;
  }

  .currentWeatherCondition {
    margin-top: 0.75rem;
    font-size: 1.1rem;
  }

  .currentWeatherDetails {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .weatherDetail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: $chip-bg;
    border: 1px solid $chip-border;
    border-radius: 0.9rem;
  }

  .weatherDetail > span {
    font-size: 1.5rem;
  }

  .weatherDetail p {
    margin: 0;
  }

  .weatherDetailLabel {
    margin-bottom: 0.2rem !important;
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 0.65;
  }

  @media (max-width: 600px) {
    .currentWeather {
      padding: 1.25rem;
    }

    .currentWeatherDetails {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { countryCodeEmoji } from 'country-code-emoji';
  import {
    $weatherData,
    $temperatureUnit,
    type TemperatureUnit,
    type WeatherInfo,
  } from '../stores/weatherStore';
  import {
    celsiusToFahrenheit,
    getWeatherDescription,
  } from '../scripts/weatherDisplay';

  let currentTemperatureCelsius: number | null = null;
  let currentUnit: TemperatureUnit = 'celsius';

  function displayTemperature() {
    if (currentTemperatureCelsius === null) {
      return;
    }

    const temperature = document.querySelector<HTMLElement>(
      '#currentTemperature',
    );

    const temperatureUnit = document.querySelector<HTMLElement>(
      '#currentTemperatureUnit',
    );

    if (!temperature || !temperatureUnit) {
      return;
    }

    if (currentUnit === 'fahrenheit') {
      temperature.textContent = Math.round(
        celsiusToFahrenheit(currentTemperatureCelsius),
      ).toString();

      temperatureUnit.textContent = '°F';
      return;
    }

    temperature.textContent = Math.round(currentTemperatureCelsius).toString();

    temperatureUnit.textContent = '°C';
  }

  function updateCurrentWeather(info: WeatherInfo | null) {
    if (!info) {
      return;
    }

    const { weather, city, countryCode } = info;
    const countryFlag = countryCode ? countryCodeEmoji(countryCode) : null;

    currentTemperatureCelsius = weather.current.temperature_2m;

    const humidity = document.querySelector<HTMLElement>('#currentHumidity');

    const wind = document.querySelector<HTMLElement>('#currentWind');

    const condition = document.querySelector<HTMLElement>('#currentCondition');

    const icon = document.querySelector<HTMLElement>('#currentWeatherIcon');

    const cityElement = document.querySelector<HTMLElement>('#currentCity');

    const date = document.querySelector<HTMLElement>('#currentDate');

    const weatherDescription = getWeatherDescription(
      weather.current.weather_code,
    );

    displayTemperature();

    if (humidity) {
      humidity.textContent = `${weather.current.relative_humidity_2m}%`;
    }

    if (wind) {
      wind.textContent = `${Math.round(weather.current.wind_speed_10m)} km/h`;
    }

    if (condition) {
      condition.textContent = weatherDescription.condition;
    }

    if (icon) {
      icon.textContent = weatherDescription.icon;
      icon.className = `currentWeatherIcon ${weatherDescription.class}`;
    }

    if (cityElement) {
      cityElement.textContent = countryFlag ? countryFlag + ' ' + city : city;
    }

    if (date) {
      date.textContent = new Date().toLocaleDateString('en-CA', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
      });
    }
  }

  $weatherData.subscribe(updateCurrentWeather);

  $temperatureUnit.subscribe((unit) => {
    currentUnit = unit;

    displayTemperature();
  });
</script>
