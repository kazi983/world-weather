<section id="currentWeather" class="currentWeather">
  <div class="currentWeatherHeader">
    <div>
      <p class="currentWeatherLabel">Current Weather</p>
      <h2 id="currentCity">Vancouver</h2>
      <p id="currentDate">Today</p>
    </div>

    <span
      id="currentWeatherIcon"
      class="currentWeatherIcon"
      role="img"
      aria-label="Weather condition"
    >
      ☀️
    </span>
  </div>

  <div class="currentWeatherMain">
    <p class="currentWeatherTemperature">
      <span id="currentTemperature">--</span>°C
    </p>

    <p id="currentCondition" class="currentWeatherCondition">
      Loading weather...
    </p>
  </div>

  <div class="currentWeatherDetails">
    <div class="weatherDetail">
      <span aria-hidden="true">💧</span>
      <div>
        <p class="weatherDetailLabel">Humidity</p>
        <p id="currentHumidity">--%</p>
      </div>
    </div>

    <div class="weatherDetail">
      <span aria-hidden="true">💨</span>
      <div>
        <p class="weatherDetailLabel">Wind</p>
        <p id="currentWind">-- km/h</p>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .currentWeather {
    width: min(900px, calc(100% - 2rem));
    margin: 2rem auto;
    padding: 2rem;
    background: white;
    border-radius: 1.25rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 8%);
  }

  .currentWeatherHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .currentWeatherLabel {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }

  .currentWeatherHeader h2 {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }

  .currentWeatherHeader p {
    margin-top: 0.35rem;
  }

  .currentWeatherIcon {
    font-size: clamp(3rem, 8vw, 5rem);
  }

  .currentWeatherMain {
    margin-top: 1.5rem;
  }

  .currentWeatherTemperature {
    margin: 0;
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 700;
    line-height: 1;
  }

  .currentWeatherCondition {
    margin-top: 0.75rem;
    font-size: 1.1rem;
  }

  .currentWeatherDetails {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .weatherDetail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: #f5f7fa;
    border-radius: 0.9rem;
  }

  .weatherDetail > span {
    font-size: 1.5rem;
  }

  .weatherDetail p {
    margin: 0;
  }

  .weatherDetailLabel {
    margin-bottom: 0.2rem !important;
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 0.65;
  }

  @media (max-width: 600px) {
    .currentWeather {
      padding: 1.25rem;
    }

    .currentWeatherDetails {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  type WeatherData = {
    current: {
      temperature_2m: number;
      relative_humidity_2m: number;
      weather_code: number;
      wind_speed_10m: number;
    };
  };

  type WeatherEvent = CustomEvent<{
    weather: WeatherData;
    city: string;
  }>;

  function getWeatherDescription(code: number) {
    if (code === 0) {
      return { condition: 'Clear sky', icon: '☀️' };
    }

    if (code === 1 || code === 2) {
      return { condition: 'Partly cloudy', icon: '🌤️' };
    }

    if (code === 3) {
      return { condition: 'Overcast', icon: '☁️' };
    }

    if (code === 45 || code === 48) {
      return { condition: 'Fog', icon: '🌫️' };
    }

    if (code >= 51 && code <= 57) {
      return { condition: 'Drizzle', icon: '🌦️' };
    }

    if (code >= 61 && code <= 67) {
      return { condition: 'Rain', icon: '🌧️' };
    }

    if (code >= 71 && code <= 77) {
      return { condition: 'Snow', icon: '❄️' };
    }

    if (code >= 80 && code <= 82) {
      return { condition: 'Rain showers', icon: '🌧️' };
    }

    if (code >= 85 && code <= 86) {
      return { condition: 'Snow showers', icon: '🌨️' };
    }

    if (code >= 95) {
      return { condition: 'Thunderstorm', icon: '⛈️' };
    }

    return { condition: 'Unknown', icon: '🌡️' };
  }

  window.addEventListener('weatherDataUpdated', (event) => {
    const customEvent = event as WeatherEvent;
    const { weather, city } = customEvent.detail;

    const temperature = document.querySelector<HTMLElement>(
      '#currentTemperature',
    );
    const humidity = document.querySelector<HTMLElement>('#currentHumidity');
    const wind = document.querySelector<HTMLElement>('#currentWind');
    const condition = document.querySelector<HTMLElement>('#currentCondition');
    const icon = document.querySelector<HTMLElement>('#currentWeatherIcon');
    const cityElement = document.querySelector<HTMLElement>('#currentCity');
    const date = document.querySelector<HTMLElement>('#currentDate');

    const weatherDescription = getWeatherDescription(
      weather.current.weather_code,
    );

    if (temperature) {
      temperature.textContent = Math.round(
        weather.current.temperature_2m,
      ).toString();
    }

    if (humidity) {
      humidity.textContent = `${weather.current.relative_humidity_2m}%`;
    }

    if (wind) {
      wind.textContent = `${Math.round(weather.current.wind_speed_10m)} km/h`;
    }

    if (condition) {
      condition.textContent = weatherDescription.condition;
    }

    if (icon) {
      icon.textContent = weatherDescription.icon;
    }

    if (cityElement) {
      cityElement.textContent = city;
    }

    if (date) {
      date.textContent = new Date().toLocaleDateString('en-CA', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
      });
    }
  });
</script>
