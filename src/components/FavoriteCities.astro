<div class="favoriteContainer">
  <div id="favoriteListContainer" class="relative">
    <button
      id="favoriteListToggleButton"
      type="button"
      aria-expanded="false"
      aria-controls="favoriteList"
      class="left-10 bg-white p-2 border border-gray-300 rounded-lg cursor-pointer"
    >
      Favorites ▼
    </button>

    <ul
      id="favoriteList"
      aria-expanded="false"
      class="hidden top-full right-0 left-0 z-1 absolute bg-white shadow-lg mt-1 py-1 border border-gray-300 rounded-2xl max-h-56 overflow-auto text-sm"
    ></ul>
  </div>

  <!-- TODO move into weather card -->
  <button
    id="favoriteButton"
    class="favoriteButton"
    type="button"
    aria-pressed="false"
    aria-label="Add to favorites"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      data-lucide="star"
      aria-hidden="true"
      class="lucide lucide-star"
    >
      <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path>
    </svg>
  </button>
</div>

<style lang="scss">
  .favorite {
    &Container {
      display: flex;
      justify-content: center;
      gap: 1rem;
    }
    &Button {
      cursor: pointer;
      svg {
        fill: none;
        transition: fill 0.2s ease;
      }

      &[aria-pressed='true'] svg {
        fill: currentColor;
      }
    }
  }
</style>

<script>
  import {
    selectedPlace,
    $favoriteCities,
    isFavorited,
    toggleFavorite,
    type FavoriteCity,
  } from '../stores/weatherStore';

  // ==========================================================================
  // DOM
  // ==========================================================================

  const favoriteListToggleButton = document.querySelector<HTMLButtonElement>(
    '#favoriteListToggleButton',
  );
  const favoriteButton =
    document.querySelector<HTMLButtonElement>('#favoriteButton');

  const favoriteList =
    document.querySelector<HTMLUListElement>('#favoriteList');

  // ==========================================================================
  // Functions
  // ==========================================================================

  /**
   * Updates the favorite button state based on whether the selected city is favorited.
   */
  function updateFavoriteButton(): void {
    if (!favoriteButton) throw new Error(`Failed to get DOM: #favoriteButton`);

    const place = selectedPlace.get();

    favoriteButton.setAttribute(
      'aria-pressed',
      String(place !== null && isFavorited(place)),
    );
  }

  /**
   * Renders the favorite city list from the given favorites.
   */
  function renderFavoriteList(favoriteCities: readonly FavoriteCity[]): void {
    if (!favoriteList) throw new Error(`Failed to get DOM: #favoriteList`);

    favoriteList.innerHTML = '';

    if (favoriteCities.length === 0) {
      const defaultOption = document.createElement('li');
      defaultOption.textContent = '---';
      favoriteList.append(defaultOption);
    } else {
      favoriteCities.forEach((favorite) => {
        const favoriteCityItem = document.createElement('li');
        const favoriteCityButton = document.createElement('button');

        favoriteCityButton.dataset.id = favorite.id;
        favoriteCityButton.dataset.lat = String(favorite.lat);
        favoriteCityButton.dataset.lng = String(favorite.lng);
        favoriteCityButton.type = 'button';
        favoriteCityButton.classList.add(
          'cursor-pointer',
          'p-2',
          'transfer-',
          'hover:bg-gray-100',
        );

        favoriteCityButton.textContent = [
          favorite.city,
          favorite.administrative,
          favorite.country,
        ].join(', ');

        favoriteCityItem.append(favoriteCityButton);
        favoriteList.append(favoriteCityItem);
      });
    }
  }

  /**
   * Opens the favorite city list and updates its contents.
   */
  function openFavoriteList(): void {
    if (!favoriteList) throw new Error(`Failed to get DOM: #favoriteList`);
    if (!favoriteListToggleButton)
      throw new Error(`Failed to get DOM: #favoriteListToggleButton`);

    favoriteList.classList.remove('hidden');
    favoriteListToggleButton.setAttribute('aria-expanded', 'true');
  }

  /**
   * Closes the favorite city list.
   */
  function closeFavoriteList(): void {
    if (!favoriteList) throw new Error(`Failed to get DOM: #favoriteList`);
    if (!favoriteListToggleButton)
      throw new Error(`Failed to get DOM: #favoriteListToggleButton`);

    favoriteList.classList.add('hidden');
    favoriteListToggleButton.setAttribute('aria-expanded', 'false');
  }

  // ==========================================================================
  // Event listeners
  // ==========================================================================

  favoriteListToggleButton?.addEventListener('click', () => {
    if (!favoriteList) throw new Error(`Failed to get DOM: #favoriteList`);

    const isExpanded = favoriteList.getAttribute('aria-expanded') === 'true';

    if (!isExpanded) {
      openFavoriteList();
    } else {
      closeFavoriteList();
    }
  });

  favoriteButton?.addEventListener('click', () => {
    const place = selectedPlace.get();

    if (!place) return;

    toggleFavorite(place);
  });

  favoriteList?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const cityButton = target.closest('button');
    if (!cityButton) return;

    const lat = cityButton.dataset.lat;
    const lng = cityButton.dataset.lng;

    // TODO Pass lat and lng to WeatherAPI
    // console.log('lat :>> ', lat);
    // console.log('lng :>> ', lng);

    closeFavoriteList();
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    if (!event.target.closest('#favoriteListContainer')) {
      closeFavoriteList();
    }
  });

  // ==========================================================================
  // Store subscriptions
  // ==========================================================================

  $favoriteCities.subscribe((favoriteCities) => {
    renderFavoriteList(favoriteCities);
    updateFavoriteButton();
  });

  selectedPlace.subscribe(() => {
    updateFavoriteButton();
  });
</script>
