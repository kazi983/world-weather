<div class="favoriteContainer">
  <select id="favoriteCities" class="left-10 bg-white p-2 border border-gray-300 rounded-lg">
  </select>

  <button id="favoriteButton" class="favoriteButton">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      data-lucide="star"
      aria-hidden="true"
      class="lucide lucide-star"
      ><path
        d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"
      ></path></svg
    >
  </button>
</div>

<style lang="scss">
  .favorite {
    &Container {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
    &Button svg {
    fill: none;
    transition: fill 0.2s ease;
  }
    &Button[data-favorited='true'] svg {
      fill: currentColor;
    }
  }
</style>

<script>
  // ==========================================================================
  // Type
  // ==========================================================================

  type City = {
    city: string;
    administrative: string;
    country: string;
    lat: number;
    lng: number;
    coordinates: string;
  };

  // ==========================================================================
  // DOM
  // ==========================================================================

  const favoriteCitiesSelector = document.querySelector<HTMLSelectElement>('#favoriteCities');
  const favoriteButton = document.querySelector<HTMLButtonElement>('#favoriteButton');

  // ==========================================================================
  // Functions
  // ==========================================================================

  function toggleFavorited() {
    if (!favoriteButton) throw new Error(`Failed to get DOM: #favoriteButton`);
    if (!favoriteCitiesSelector) throw new Error(`Failed to get DOM: #favoriteCities`);

    const isFavorited = favoriteCities.some(
      (favorite) => favorite.coordinates === favoriteCitiesSelector.value,
    );

    favoriteButton.dataset.favorited = String(isFavorited);
  }

  function displayOptions() {
    if (favoriteCitiesSelector) {
      favoriteCitiesSelector.innerHTML = '';
    }

    console.log('favoriteCities :>> ', favoriteCities.length);

    if (favoriteCities.length === 0) {
      const defaultOption = document.createElement('option');
      defaultOption.textContent = 'Favorites';

      favoriteCitiesSelector?.append(defaultOption);
    } else {
      favoriteCities.forEach((favorite) => {
        const cityElement = document.createElement('option');

        cityElement.value = favorite.coordinates;
        cityElement.dataset.lat = String(favorite.lat);
        cityElement.dataset.lng = String(favorite.lng);

        cityElement.textContent = [favorite.city, favorite.administrative, favorite.country].join(
          ', ',
        );

        favoriteCitiesSelector?.append(cityElement);
      });
    }
  }

  function getFavoriteCities(): City[] {
    try {
      return JSON.parse(localStorage.getItem('favoriteCities') ?? '[]');
    } catch {
      return [];
    }
  }

  // ==========================================================================
  // Event listeners
  // ==========================================================================

  favoriteCitiesSelector?.addEventListener('change', (event) => {
    const select = event?.currentTarget as HTMLSelectElement;
    const [lat, lng] = select.value.split(',').map(Number);

    // Pass lat and lng to WeatherAPI
  });

  favoriteButton?.addEventListener('click', () => {
    // FIXME: replace this with global state
    let selectedPlace = {
      name: '大阪市',
      highlight: '大阪市',
      city: '大阪市',
      county: '泉北郡',
      administrative: '大阪府',
      country: '日本',
      administrativecode: '',
      countrycode: 'jp',
      countycode: '',
      zipcode: ['543-0062'],
      population: 2643805,
      lat: 34.6937569,
      lng: 135.5014539,
      coordinates: '34.6937569, 135.5014539',
      type: 'city',
    };

    if (
      selectedPlace &&
      favoriteCities.find((favorite) => favorite.coordinates === selectedPlace.coordinates)
    ) {
      favoriteButton?.classList.remove('favorite');
      favoriteCities = favoriteCities.filter(
        (favorite) => favorite.coordinates !== selectedPlace.coordinates,
      );
    } else {
      favoriteButton?.classList.add('favorite');
      favoriteCities.push(selectedPlace);
    }

    localStorage.setItem('favoriteCities', JSON.stringify(favoriteCities));
    displayOptions();
    toggleFavorited();
  });

  // ==========================================================================
  // Initialize
  // ==========================================================================

  let favoriteCities = getFavoriteCities();
  displayOptions();
  toggleFavorited();
</script>
